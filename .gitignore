#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets & signing
*.jks
*.keystore
.env
secrets.*
key.properties

# Output
output/

# Director reference images
references/

# Saved-character runtime data (personas, closets) — app writes these to the
# working dir during dev; they are user data, not source. Anchored to repo root
# so it never matches lib/features/characters or test/characters.
/characters/

# Stray nested folder
2.0/

# Session snapshots
session_snapshot.json
/cascade_previews/

# Windows reserved device names
nul

# ML model directories and files (downloaded at runtime)
ml_models/
RMBG-2.0/
ani-sd/
isnet-anime/
sam 2.1-tiny/
*.onnx

# Soundfont files (downloaded at runtime)
soundfonts/

# Dev/test files
*.mid
*.sf2
# ...but product jukebox MIDI under assets/midi/ ships in-repo (like the .kar
# songs), so un-ignore it. Stray dev/test .mid elsewhere stays ignored.
!assets/midi/**/*.mid
test_itxt.dart
EXAMPLEINPAINTED.png

# Wiki preprocessing artifacts (downloaded; rebuilt by Tags/build_wiki_asset.py)
Tags/_wiki_raw/

# Windows shell shortcuts accidentally dropped in the project folder
*.lnk
